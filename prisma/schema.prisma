// GuruLens — Teacher Discovery + Education Social Platform
// Prisma schema (PostgreSQL — Neon for local/production, Cloudflare Workers runtime).
// Enums are stored as validated strings.

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

// ---------------------------------------------------------------------------
// Users & auth
// ---------------------------------------------------------------------------

// role: student | teacher | moderator | admin
// status: active | suspended | pending_deletion
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  role          String    @default("student")
  status        String    @default("active")
  name          String
  avatarKey     String?
  dateOfBirth   DateTime?
  ageEligible   Boolean   @default(false)
  emailVerified Boolean   @default(false)
  mfaEnabled    Boolean   @default(false)
  mfaSecret     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  teacherProfile       TeacherProfile?
  sessions             Session[]
  posts                Post[]
  comments             Comment[]
  reactions            Reaction[]
  reviews              Review[]              @relation("reviewAuthor")
  reviewsReceived      Review[]              @relation("reviewTeacher")
  enrollmentCodes      EnrollmentCode[]
  eligibilitiesGiven   ReviewEligibility[]   @relation("eligTeacher")
  eligibilitiesHeld    ReviewEligibility[]   @relation("eligStudent")
  reportsFiled         Report[]              @relation("reporter")
  reportsHandled       Report[]              @relation("reportHandler")
  moderationActions    ModerationAction[]
  auditLogs            AuditLog[]
  following            Follow[]              @relation("follower")
  followers            Follow[]              @relation("followed")
  savedPosts           SavedPost[]
  notifications        Notification[]
  quizAttempts         QuizAttempt[]
  membershipTiers      MembershipTier[]
  memberships          Membership[]
  verificationRequests VerificationRequest[] @relation("teacherRequests")
  reviewedRequests     VerificationRequest[] @relation("reviewerRequests")
  badgeGrants          BadgeGrant[]

  // New relations for ecosystem upgrade
  organizationMemberships OrganizationMember[]
  channelFollows          ChannelFollow[]
  channelPosts            ChannelPost[]
  channelReactions        ChannelReaction[]
  pollVotes               PollVote[]
  teacherClasses          Class[]              @relation("teacherClasses")
  studentEnrollments      ClassEnrollment[]    @relation("studentEnrollments")
  studentAttendance       Attendance[]         @relation("studentAttendance")
  studentSubmissions      Submission[]         @relation("studentSubmissions")
  guardian                Guardian?
  guardianRelations       GuardianStudent[]    @relation("guardianRelations")
  subscriptions           UserSubscription[]
  studentCard             StudentCard?

  @@index([role, status])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  csrfToken String
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Teacher profiles & taxonomy
// ---------------------------------------------------------------------------

model TeacherProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  handle          String    @unique
  tagline         String?
  bio             String?
  mode            String    @default("both") // physical | online | both
  experienceYears Int?
  qualifications  String?
  consentPublic   Boolean   @default(false)
  // verifiedStatus: none | pending | in_review | more_info | verified | rejected
  verifiedStatus  String    @default("none")
  verifiedAt      DateTime?
  coverKey        String?
  contactPhone    String?
  contactEmail    String?
  whatsapp        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects  TeacherSubject[]
  districts TeacherDistrict[]
  grades    TeacherGrade[]
  languages TeacherLanguage[]

  @@index([verifiedStatus])
}

model Subject {
  id     String  @id @default(cuid())
  slug   String  @unique
  name   String
  nameSi String?

  teachers TeacherSubject[]
}

model District {
  id       String  @id @default(cuid())
  slug     String  @unique
  name     String
  nameSi   String?
  province String

  teachers TeacherDistrict[]
}

model Grade {
  id    String @id @default(cuid())
  slug  String @unique
  name  String
  order Int

  teachers TeacherGrade[]
}

model Language {
  id   String @id @default(cuid())
  slug String @unique
  name String

  teachers TeacherLanguage[]
}

model TeacherSubject {
  teacherId String
  subjectId String

  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([teacherId, subjectId])
  @@index([subjectId])
}

model TeacherDistrict {
  teacherId  String
  districtId String

  teacher  TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  district District       @relation(fields: [districtId], references: [id], onDelete: Cascade)

  @@id([teacherId, districtId])
  @@index([districtId])
}

model TeacherGrade {
  teacherId String
  gradeId   String

  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  grade   Grade          @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  @@id([teacherId, gradeId])
  @@index([gradeId])
}

model TeacherLanguage {
  teacherId  String
  languageId String

  teacher  TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  language Language       @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@id([teacherId, languageId])
  @@index([languageId])
}

// ---------------------------------------------------------------------------
// Verification & badges
// ---------------------------------------------------------------------------

// status: pending | in_review | more_info | approved | rejected
model VerificationRequest {
  id           String   @id @default(cuid())
  teacherId    String
  status       String   @default("pending")
  evidenceKey  String?
  evidenceNote String?
  reviewerId   String?
  actionReason String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  teacher  User  @relation("teacherRequests", fields: [teacherId], references: [id], onDelete: Cascade)
  reviewer User? @relation("reviewerRequests", fields: [reviewerId], references: [id])

  @@index([status])
  @@index([teacherId])
}

// kind: verification | achievement
model Badge {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  nameSi      String?
  description String
  kind        String  @default("achievement")

  grants BadgeGrant[]
}

model BadgeGrant {
  id          String    @id @default(cuid())
  badgeId     String
  userId      String
  grantedById String?
  reason      String?
  grantedAt   DateTime  @default(now())
  revokedAt   DateTime?
  active      Boolean   @default(true)

  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
  @@index([badgeId])
}

// ---------------------------------------------------------------------------
// Content: posts, media, social graph
// ---------------------------------------------------------------------------

// type: post | announcement | lesson | reel | video
// moderationStatus: pending | approved | rejected | removed
model Post {
  id               String   @id @default(cuid())
  authorId         String
  type             String   @default("post")
  title            String?
  text             String
  mediaIds         String? // JSON array of Media ids (images)
  videoId          String? // Media id for reel/video
  subjectId        String?
  gradeId          String?
  visibility       String   @default("public") // public | members
  moderationStatus String   @default("approved")
  likeCount        Int      @default(0)
  commentCount     Int      @default(0)
  saveCount        Int      @default(0)
  viewCount        Int      @default(0)
  publishedAt      DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments  Comment[]
  reactions Reaction[]
  saves     SavedPost[]

  @@index([authorId, moderationStatus, publishedAt])
  @@index([type, moderationStatus, publishedAt])
  @@index([moderationStatus, publishedAt])
}

// kind: avatar | cover | post_image | video | reel | doc
// visibility: public | private
model Media {
  id          String   @id @default(cuid())
  ownerId     String
  kind        String
  storageKey  String   @unique
  mimeType    String
  sizeBytes   Int
  width       Int?
  height      Int?
  durationSec Float?
  thumbKey    String?
  visibility  String   @default("public")
  createdAt   DateTime @default(now())

  @@index([ownerId])
}

model Follow {
  followerId String
  teacherId  String
  createdAt  DateTime @default(now())

  follower User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  teacher  User @relation("followed", fields: [teacherId], references: [id], onDelete: Cascade)

  @@id([followerId, teacherId])
  @@index([teacherId])
}

model Reaction {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  type      String   @default("like") // like | love | clap
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
}

// moderationStatus: pending | approved | rejected | removed
model Comment {
  id               String   @id @default(cuid())
  postId           String
  authorId         String
  text             String
  moderationStatus String   @default("approved")
  createdAt        DateTime @default(now())

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model SavedPost {
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
}

// ---------------------------------------------------------------------------
// Reviews & eligibility
// ---------------------------------------------------------------------------

// status: published | pending | removed
model Review {
  id                String    @id @default(cuid())
  teacherId         String
  authorId          String
  stars             Int
  clarity           Int?
  support           Int?
  organization      Int?
  feedback          String
  eligibilityStatus String    @default("verified") // verified | pending
  status            String    @default("published")
  teacherReply      String?
  teacherRepliedAt  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  teacher User @relation("reviewTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  author  User @relation("reviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([teacherId, authorId])
  @@index([teacherId, status, createdAt])
}

// status: claimed | verified | revoked
model ReviewEligibility {
  id        String   @id @default(cuid())
  teacherId String
  studentId String
  codeId    String?
  status    String   @default("claimed")
  createdAt DateTime @default(now())

  teacher User            @relation("eligTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  student User            @relation("eligStudent", fields: [studentId], references: [id], onDelete: Cascade)
  code    EnrollmentCode? @relation(fields: [codeId], references: [id])

  @@unique([teacherId, studentId])
  @@index([studentId])
}

model EnrollmentCode {
  id        String    @id @default(cuid())
  teacherId String
  code      String    @unique
  label     String?
  maxUses   Int       @default(1)
  uses      Int       @default(0)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  teacher       User                @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  eligibilities ReviewEligibility[]

  @@index([teacherId])
}

// ---------------------------------------------------------------------------
// Quizzes
// ---------------------------------------------------------------------------

// moderationStatus: pending | approved | rejected | removed
model Quiz {
  id               String   @id @default(cuid())
  teacherId        String
  title            String
  description      String?
  subjectId        String?
  gradeId          String?
  timeLimitMin     Int?
  published        Boolean  @default(false)
  moderationStatus String   @default("approved")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([teacherId, published])
}

model QuizQuestion {
  id           String  @id @default(cuid())
  quizId       String
  order        Int
  text         String
  options      String // JSON array of strings
  correctIndex Int
  explanation  String?

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId, order])
}

model QuizAttempt {
  id          String   @id @default(cuid())
  quizId      String
  studentId   String
  answers     String // JSON array of chosen indexes
  score       Int
  total       Int
  completedAt DateTime @default(now())

  quiz    Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([quizId, score])
  @@index([studentId])
}

// ---------------------------------------------------------------------------
// Moderation, reports, audit
// ---------------------------------------------------------------------------

// targetType: post | comment | review | user | quiz | media
// status: open | in_review | resolved | dismissed
model Report {
  id             String   @id @default(cuid())
  reporterId     String
  targetType     String
  targetId       String
  reason         String
  details        String?
  status         String   @default("open")
  resolutionNote String?
  handledById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  reporter  User  @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  handledBy User? @relation("reportHandler", fields: [handledById], references: [id])

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

model ModerationAction {
  id         String   @id @default(cuid())
  actorId    String
  targetType String
  targetId   String
  action     String
  reason     String?
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  targetRef String?
  meta      String?
  createdAt DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([actorId])
}

// ---------------------------------------------------------------------------
// Memberships (Patreon-style support, no payments at launch)
// ---------------------------------------------------------------------------

model MembershipTier {
  id          String   @id @default(cuid())
  teacherId   String
  name        String
  description String?
  priceLkr    Int      @default(0)
  perks       String? // JSON array
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  teacher User         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  members Membership[]

  @@index([teacherId])
}

// status: active | cancelled
model Membership {
  id       String   @id @default(cuid())
  tierId   String
  memberId String
  status   String   @default("active")
  joinedAt DateTime @default(now())

  tier   MembershipTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  member User           @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([tierId, memberId])
  @@index([memberId])
}

// ---------------------------------------------------------------------------
// Notifications & settings
// ---------------------------------------------------------------------------

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Organizations (Institutes & Schools)
// ---------------------------------------------------------------------------

// type: institute | school
// verifiedStatus: none | pending | in_review | verified | rejected | suspended
model Organization {
  id             String    @id @default(cuid())
  type           String    @default("institute")
  name           String
  slug           String    @unique
  nameSi         String?
  description    String?
  logoKey        String?
  coverKey       String?
  website        String?
  phone          String?
  email          String?
  address        String?
  verifiedStatus String    @default("none")
  verifiedAt     DateTime?
  settings       String? // JSON: features, limits, preferences
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  branches             OrganizationBranch[]
  members              OrganizationMember[]
  channels             Channel[]
  classes              Class[]
  verificationRequests OrganizationVerificationRequest[]

  @@index([type, verifiedStatus])
  @@index([slug])
}

model OrganizationBranch {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  address        String?
  phone          String?
  isMain         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      OrganizationMember[]
  classes      Class[]

  @@index([organizationId])
}

// role: owner | admin | manager | teacher | staff
// status: active | invited | suspended | removed
model OrganizationMember {
  id             String    @id @default(cuid())
  organizationId String
  branchId       String?
  userId         String
  role           String    @default("teacher")
  permissions    String? // JSON array of permission keys
  status         String    @default("active")
  invitedAt      DateTime?
  joinedAt       DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       OrganizationBranch? @relation(fields: [branchId], references: [id])
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([branchId])
}

// status: pending | in_review | approved | rejected
model OrganizationVerificationRequest {
  id             String   @id @default(cuid())
  organizationId String
  status         String   @default("pending")
  evidenceKeys   String? // JSON array of media keys
  evidenceNote   String?
  reviewerId     String?
  actionReason   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Channels (Educational communication)
// ---------------------------------------------------------------------------

// ownerType: user | organization
// type: personal | institute | school
// visibility: public | private | members
// verifiedStatus: none | pending | in_review | verified | rejected
model Channel {
  id             String    @id @default(cuid())
  ownerId        String // userId or organizationId
  ownerType      String    @default("user")
  organizationId String? // If owned by organization
  name           String
  slug           String    @unique
  description    String?
  avatarKey      String?
  coverKey       String?
  visibility     String    @default("public")
  type           String    @default("personal")
  verifiedStatus String    @default("none")
  verifiedAt     DateTime?
  followerCount  Int       @default(0)
  postCount      Int       @default(0)
  settings       String? // JSON: notifications, permissions
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization         Organization?                @relation(fields: [organizationId], references: [id])
  posts                ChannelPost[]
  followers            ChannelFollow[]
  verificationRequests ChannelVerificationRequest[]

  @@index([ownerId, ownerType])
  @@index([organizationId])
  @@index([visibility, isActive])
  @@index([slug])
}

model ChannelFollow {
  channelId String
  userId    String
  notifyOn  String?  @default("all") // all | urgent | none
  createdAt DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@index([userId])
}

// type: text | image | video | audio | document | poll | quiz | announcement
// moderationStatus: pending | approved | rejected | removed
model ChannelPost {
  id               String    @id @default(cuid())
  channelId        String
  authorId         String
  type             String    @default("text")
  content          String?
  mediaKeys        String? // JSON array of media keys
  isPinned         Boolean   @default(false)
  isUrgent         Boolean   @default(false)
  scheduledAt      DateTime?
  publishedAt      DateTime?
  moderationStatus String    @default("approved")
  reactionCount    Int       @default(0)
  viewCount        Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  channel      Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author       User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reactions    ChannelReaction[]
  voiceMessage VoiceMessage?
  poll         Poll?

  @@index([channelId, publishedAt])
  @@index([channelId, isPinned])
  @@index([authorId])
}

// type: like | love | clap | fire | sad
model ChannelReaction {
  id            String   @id @default(cuid())
  channelPostId String
  userId        String
  type          String   @default("like")
  createdAt     DateTime @default(now())

  post ChannelPost @relation(fields: [channelPostId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelPostId, userId])
  @@index([channelPostId])
}

model VoiceMessage {
  id            String   @id @default(cuid())
  channelPostId String   @unique
  audioKey      String
  durationSec   Float
  waveform      String? // JSON array for visualization
  createdAt     DateTime @default(now())

  post ChannelPost @relation(fields: [channelPostId], references: [id], onDelete: Cascade)
}

model Poll {
  id            String    @id @default(cuid())
  channelPostId String    @unique
  question      String
  options       String // JSON array of option strings
  allowMultiple Boolean   @default(false)
  endsAt        DateTime?
  createdAt     DateTime  @default(now())

  post  ChannelPost @relation(fields: [channelPostId], references: [id], onDelete: Cascade)
  votes PollVote[]
}

model PollVote {
  id          String   @id @default(cuid())
  pollId      String
  userId      String
  optionIndex Int
  createdAt   DateTime @default(now())

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId, optionIndex])
  @@index([pollId])
}

// status: pending | in_review | approved | rejected
model ChannelVerificationRequest {
  id           String   @id @default(cuid())
  channelId    String
  status       String   @default("pending")
  evidenceKeys String? // JSON array of media keys
  evidenceNote String?
  reviewerId   String?
  actionReason String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// ClassHub (Class management)
// ---------------------------------------------------------------------------

// mode: physical | online | both
// status: active | archived | draft
model Class {
  id             String   @id @default(cuid())
  teacherId      String
  organizationId String?
  branchId       String?
  name           String
  description    String?
  subjectId      String?
  gradeId        String?
  mode           String   @default("both")
  schedule       String? // JSON: days, times, duration
  maxStudents    Int?
  feeAmount      Int?
  feeCurrency    String   @default("LKR")
  feeFrequency   String   @default("monthly") // monthly | per_session | course
  location       String?
  onlineLink     String?
  status         String   @default("active")
  channelId      String? // Linked channel for announcements
  coverKey       String? // Media id for the class thumbnail
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  teacher      User                @relation("teacherClasses", fields: [teacherId], references: [id], onDelete: Cascade)
  organization Organization?       @relation(fields: [organizationId], references: [id])
  branch       OrganizationBranch? @relation(fields: [branchId], references: [id])
  enrollments  ClassEnrollment[]
  sessions     ClassSession[]
  assignments  Assignment[]

  @@index([teacherId, status])
  @@index([organizationId])
  @@index([subjectId])
}

// status: active | completed | withdrawn | pending
model ClassEnrollment {
  id          String    @id @default(cuid())
  classId     String
  studentId   String
  status      String    @default("pending")
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  student User  @relation("studentEnrollments", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
  @@index([studentId])
}

// status: scheduled | in_progress | completed | cancelled
model ClassSession {
  id          String   @id @default(cuid())
  classId     String
  scheduledAt DateTime
  duration    Int // minutes
  topic       String?
  notes       String?
  status      String   @default("scheduled")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  class      Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  attendance Attendance[]

  @@index([classId, scheduledAt])
}

// status: present | absent | late | excused
// method: manual | device | virtual
model Attendance {
  id           String    @id @default(cuid())
  sessionId    String
  studentId    String
  status       String    @default("present")
  checkedInAt  DateTime?
  checkedOutAt DateTime?
  method       String    @default("manual")
  deviceId     String?
  notes        String?
  createdAt    DateTime  @default(now())

  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student User         @relation("studentAttendance", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([studentId])
}

model Assignment {
  id          String    @id @default(cuid())
  classId     String
  title       String
  description String?
  dueAt       DateTime?
  maxScore    Int?
  attachments String? // JSON array of media keys
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@index([classId, dueAt])
}

// status: submitted | graded | late | resubmit
model Submission {
  id           String    @id @default(cuid())
  assignmentId String
  studentId    String
  content      String?
  attachments  String? // JSON array of media keys
  score        Int?
  feedback     String?
  status       String    @default("submitted")
  submittedAt  DateTime  @default(now())
  gradedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation("studentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([studentId])
}

// ---------------------------------------------------------------------------
// Guardian relationships
// ---------------------------------------------------------------------------

// relationship: parent | guardian | other
model Guardian {
  id           String   @id @default(cuid())
  userId       String   @unique
  relationship String   @default("parent")
  createdAt    DateTime @default(now())

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  children GuardianStudent[]
}

model GuardianStudent {
  id         String   @id @default(cuid())
  guardianId String
  studentId  String
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  student  User     @relation("guardianRelations", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([guardianId, studentId])
  @@index([studentId])
}

// ---------------------------------------------------------------------------
// Subscription plans & entitlements
// ---------------------------------------------------------------------------

// type: free | teacher_pro | institute | institute_plus | campus_pilot | campus_pro
// billingCycle: monthly | yearly | lifetime
model Plan {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?
  type         String   @default("free")
  priceLkr     Int      @default(0)
  billingCycle String   @default("monthly")
  limits       String // JSON: channels, classes, storage, etc.
  features     String? // JSON array of feature keys
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions UserSubscription[]
}

// status: active | cancelled | expired | trial | suspended
model UserSubscription {
  id             String    @id @default(cuid())
  userId         String
  organizationId String?
  planId         String
  status         String    @default("trial")
  startedAt      DateTime  @default(now())
  expiresAt      DateTime?
  trialEndsAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan         Plan                 @relation(fields: [planId], references: [id])
  entitlements FeatureEntitlement[]

  @@index([userId])
  @@index([organizationId])
  @@index([status])
}

model FeatureEntitlement {
  id             String   @id @default(cuid())
  subscriptionId String
  feature        String // channel_count | class_count | storage_mb | etc.
  limitValue     Int
  usedValue      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscription UserSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, feature])
}

// ---------------------------------------------------------------------------
// ClassPulse (Virtual devices & attendance simulation)
// ---------------------------------------------------------------------------

// status: active | inactive | simulated
model VirtualDevice {
  id              String    @id @default(cuid())
  organizationId  String?
  classId         String?
  name            String
  deviceCode      String    @unique
  status          String    @default("simulated")
  lastSeenAt      DateTime?
  firmwareVersion String?
  settings        String? // JSON: configuration
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  events DeviceEvent[]

  @@index([organizationId])
  @@index([status])
}

// eventType: check_in | check_out | heartbeat | error | simulation
model DeviceEvent {
  id          String   @id @default(cuid())
  deviceId    String
  eventType   String
  studentId   String?
  cardNumber  String?
  payload     String? // JSON: additional data
  isSimulated Boolean  @default(true)
  createdAt   DateTime @default(now())

  device VirtualDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, createdAt])
  @@index([studentId])
}

model StudentCard {
  id         String    @id @default(cuid())
  studentId  String    @unique
  cardNumber String    @unique
  isActive   Boolean   @default(true)
  issuedAt   DateTime  @default(now())
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)
}
