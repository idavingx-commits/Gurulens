# ---------------------------------------------------------------------------
# GuruLens environment reference
# Copy to `.env` (gitignored). Never commit real credentials.
#
# Prisma CLI reads `.env` only (not `.env.local`), so keep the database URLs
# here. Next.js also loads `.env`; `.env.local` can override for the app.
# ---------------------------------------------------------------------------

# Neon PostgreSQL — pooled connection used by the application at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Neon PostgreSQL — direct (non-pooled) connection used by migrations and seed.
DIRECT_URL="postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require"

# Session signing secret. Generate with: openssl rand -base64 48
SESSION_SECRET=""

# Canonical site URL (no trailing slash). Inlined at build time.
NEXT_PUBLIC_SITE_URL="https://gurulens.us"

# ---------------------------------------------------------------------------
# Seed-only values. If left empty, the seed script generates strong random
# passwords and prints them once. They are never stored in the repository.
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@gurulens.lk"
SEED_ADMIN_PASSWORD=""
SEED_DEMO_PASSWORD=""

# ---------------------------------------------------------------------------
# Media storage — Cloudflare R2 (S3-compatible API)
# Create an R2 API token with Object Read & Write for the bucket.
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="gurulens-media"

# Public bucket domain (R2 custom domain). Public media is served from here.
MEDIA_PUBLIC_URL="https://media.gurulens.us"
