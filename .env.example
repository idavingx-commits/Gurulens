# ---------------------------------------------------------------------------
# GuruLens environment reference
# Copy to `.env` (gitignored). Never commit real credentials.
#
# Prisma CLI reads `.env` only (not `.env.local`), so keep the database URLs
# here. Next.js also loads `.env`; `.env.local` can override for the app.
#
# `neon init` / `neon deploy` can fill the Neon values automatically.
# ---------------------------------------------------------------------------

# Neon PostgreSQL — pooled connection used by the application at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Neon PostgreSQL — direct (non-pooled) connection used by migrations and seed.
# Neon CLI writes this as DATABASE_URL_UNPOOLED; keep DIRECT_URL equal to it.
DIRECT_URL="postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require"

# Session signing secret. Generate with: openssl rand -base64 48
SESSION_SECRET=""

# Canonical site URL (no trailing slash). Inlined at build time.
NEXT_PUBLIC_SITE_URL="https://gurulens.us"

# ---------------------------------------------------------------------------
# Seed-only values. If the password is left empty, the seed script generates a
# strong random password and prints it once. Never commit real credentials.
# Demo teachers/students are opt-in and must stay off in production.
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@gurulens.lk"
SEED_ADMIN_PASSWORD=""
SEED_DEMO_DATA="false"
SEED_DEMO_PASSWORD=""

# ---------------------------------------------------------------------------
# Media storage — Neon Object Storage (S3-compatible API, private bucket).
# `neon deploy` writes the AWS_* values for the linked branch.
# Bucket is declared in neon.ts; use "assets" for this project.
# ---------------------------------------------------------------------------
AWS_ENDPOINT_URL_S3=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""
MEDIA_BUCKET="assets"

# Optional public CDN/bucket domain. When empty, public media streams through
# /api/media/[id] instead of redirecting.
MEDIA_PUBLIC_URL=""

# ---------------------------------------------------------------------------
# Fallback: Cloudflare R2 (used only when the Neon AWS_* values are absent).
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="gurulens-media"
